# Ideas is passwordless by default. Set all three values only when Basic Auth is needed.
IDEA_DESK_REQUIRE_AUTH=false
IDEA_DESK_USERNAME=
IDEA_DESK_PASSWORD=

# Generate the previous week's report on Monday at 09:00 Asia/Shanghai.
# Incomplete SMTP settings keep the report on the NAS without sending email.
IDEA_DESK_WEEKLY_REPORT_ENABLED=true
IDEA_DESK_WEEKLY_MAX_ATTEMPTS=3
IDEA_DESK_WEEKLY_RETRY_SECONDS=300

# SMTP_SECURITY accepts starttls (usually port 587) or ssl (usually port 465).
IDEA_DESK_SMTP_SECURITY=starttls
IDEA_DESK_SMTP_HOST=
IDEA_DESK_SMTP_PORT=587
IDEA_DESK_SMTP_USERNAME=
IDEA_DESK_SMTP_PASSWORD=
IDEA_DESK_SMTP_FROM=
# Separate multiple recipients with commas or semicolons.
IDEA_DESK_WEEKLY_RECIPIENTS=
IDEA_DESK_SMTP_TIMEOUT_SECONDS=20
